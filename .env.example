# Copia este archivo como .env y ajusta los valores.
# NUNCA compartas tu .env con nadie (ni conmigo): contiene tu clave privada.

# ===== Modo =====
# true = simulación (recomendado al principio). Para operar en real necesitas LAS DOS líneas:
#   DRY_RUN=false
#   LIVE_CONFIRM=SI_ENTIENDO_EL_RIESGO
DRY_RUN=true
LIVE_CONFIRM=

# Clave de Jupiter (gratis en https://developers.jup.ag/portal). Recomendada.
JUPITER_API_KEY=

# Solo para modo real. Usa una wallet NUEVA y dedicada, con poco dinero.
SOLANA_PRIVATE_KEY=

# RPC de Solana. El público funciona pero es lento y limitado; Helius/QuickNode tienen planes gratis.
RPC_URL=https://api.mainnet-beta.solana.com

# ===== Riesgo =====
PAPER_START_SOL=1.0
POSITION_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.15
MIN_SOL_RESERVE=0.02
SCAN_INTERVAL_SEC=30

# ===== Filtros de entrada =====
MIN_AGE_MINUTES=20
MAX_AGE_HOURS=48
MIN_LIQUIDITY_USD=20000
MIN_MCAP_USD=60000
MAX_MCAP_USD=8000000
MIN_VOLUME_H1_USD=25000
MIN_BUYS_H1=60
MIN_BUY_SELL_RATIO_H1=1.15
MAX_BUY_SELL_RATIO_H1=4.0
MIN_CHANGE_H1_PCT=8
MAX_CHANGE_H1_PCT=150
MIN_SCORE=0.45
MAX_RUGCHECK_SCORE=30
MAX_ROUNDTRIP_LOSS_PCT=6

# ===== Salidas =====
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=60
TAKE_PROFIT_SELL_FRACTION=0.5
TRAILING_ACTIVATE_PCT=30
TRAILING_STOP_PCT=20
MAX_HOLD_MINUTES=360
LIQUIDITY_DROP_EXIT_PCT=50
